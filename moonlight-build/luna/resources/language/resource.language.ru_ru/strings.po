msgid "Applications"
msgstr "Приложения"

msgctxt "#30251"
msgid "New folder..."
msgstr "Новая папка…"

msgctxt "#30252"
msgid "New folder name"
msgstr "Имя новой папки"

msgctxt "#30253"
msgid "Move to folder..."
msgstr "Переместить в папку…"

msgctxt "#30254"
msgid "Move to folder"
msgstr "Переместить в папку"

msgctxt "#30255"
msgid "Remove from "%s""
msgstr "Удалить из «%s»"

msgctxt "#30256"
msgid "Rename folder"
msgstr "Переименовать папку"

msgctxt "#30257"
msgid "Delete folder"
msgstr "Удалить папку"

msgctxt "#30258"
msgid "Delete "%s"?\nApplications will move back to the unsorted list."
msgstr "Удалить папку «%s»?\nПриложения вернутся в общий список."

msgctxt "#30259"
msgid "List applications"
msgstr "Список приложений"

msgctxt "#30260"
msgid "Resume %s"
msgstr "Продолжить %s"

msgctxt "#30261"
msgid "Quit %s"
msgstr "Выйти из %s"

msgctxt "#30262"
msgid "Continue"
msgstr "Продолжить"

msgctxt "#30263"
